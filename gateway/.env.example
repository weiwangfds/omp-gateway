# 网关监听端口
GATEWAY_PORT=8787

# 服务间 token（上游 Python 后端持有）。逗号分隔支持双 token 轮换窗口。
GATEWAY_SERVICE_TOKENS=change-me-service-token

# 全局层管理（/admin/global/*）无独立 token：上游注入 X-Admin-Id 标识即可（权限判定在上游）。

# 数据根目录（默认 ../../data，即 monorepo 的 data/）
# GATEWAY_DATA_ROOT=/absolute/path/to/data

# 会话空闲回收 TTL（毫秒，默认 30 分钟）
# GATEWAY_SESSION_IDLE_TTL_MS=1800000

# 每用户默认限额（懒 provision 时生效；可用 PATCH /internal/users/:uid/limits 覆盖）
# maxConcurrent = 每用户可同时跑的会话/流式数（当前产品要求：10）
# GATEWAY_DEFAULT_MAX_SESSIONS=50
# GATEWAY_DEFAULT_MAX_CONCURRENT=10
# GATEWAY_MAX_GLOBAL_STREAMING=50

# 流式并发闸门（M2）：排队超时返回 429；槽位最大持有为防泄漏 backstop
# GATEWAY_STREAM_QUEUE_TIMEOUT_MS=60000
# GATEWAY_STREAM_MAX_HOLD_MS=600000

# sqlite 定时备份（M10）：设置目录即启用；VACUUM INTO 一致性快照，保留最近 8 份
# GATEWAY_BACKUP_DIR=/absolute/path/to/backups
# GATEWAY_BACKUP_INTERVAL_MIN=60

# 环境迁移 bundle（DESIGN §32）：export 写入目录；import 允许读取的根（逗号分隔）
# 跨机迁移时两台网关指向同一共享目录（NFS/挂载卷），或把 bundle 拷入对方 import 目录
# GATEWAY_EXPORT_DIR=/absolute/path/to/gateway-exports
# GATEWAY_IMPORT_DIRS=/absolute/path/to/gateway-exports,/mnt/shared/bundles

# OpenTelemetry（M10）：1 开启 SDK spans（未注册 OTEL SDK 时为 no-op）
# GATEWAY_OTEL=0

# webhook 目标 host 白名单（M10，SSRF 收紧）：逗号分隔 host，空=不限制（内网默认）
# GATEWAY_WEBHOOK_HOSTS_ALLOWLIST=hooks.internal.example.com,10.0.0.5:9000

# 浏览器直连 CORS（DESIGN §21）：逗号分隔 origin，空=关闭（默认 BFF 代理架构无需开启）
# GATEWAY_CORS_ORIGINS=http://localhost:5173,https://app.example.com

# 请求体上限（MB）：超限返回 413 PAYLOAD_TOO_LARGE（index.ts 读取）
# GATEWAY_BODY_LIMIT_MB=20

# 回收站保留天数（jobs/trash-purger 定时物理删除；设 0 = 立即清）
# GATEWAY_TRASH_TTL_DAYS=30

# 集成钩子调试日志（hooks/dispatch.ts；1 = 打印每次分发决策）
# GATEWAY_HOOKS_DEBUG=0

# ── 容器内包管理器镜像源（DESIGN §36，内网部署必配）──────────────────────────
# Docker 启动时由 entrypoint 固化成 pip.conf / .npmrc / uv.toml / .condarc，
# 只影响会话里现装的包（agent 的 pip/npm、MCP server 的 npx/uvx/conda），不影响镜像自带依赖。
# 不设置 = 一行都不写，走上游默认源（公网）。
# PIP_INDEX_URL 另一个身份：docker compose build 的 build-arg——构建期把 pymupdf + minio
# 烘进 conda base（KB 出图/取图脚本用，DESIGN §38.7）。内网构建必须设置，否则 build 阶段拉不动 PyPI。
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn          # http 源或自签证书时才需要
# PIP_CERT=/etc/omp/ca.pem                            # 内网自签 CA（挂载进容器后指向它）
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# ↑ 双角色：运行期写进 .npmrc，同时被 compose 作为构建期 NPM_REGISTRY 的回退
#   （qmd 安装层用；也可单独设 NPM_REGISTRY 覆盖构建期）。
# 构建期瘦身开关（docker compose build 时生效，见 gateway/Dockerfile）：
#   QMD_SLIM=1                           # 裁 qmd 的 cuda/vulkan/arm* 预编译 + tree-sitter（实测 4.32→3.21GB）
#   WREN_EXTRAS=mcp,postgres,clickhouse  # wrenai 数据源驱动，按部署裁剪（默认全装）
# CONDA_CHANNELS=https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/main,https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/r
# CONDA_DEFAULT_CHANNELS=                              # 让 channels 里的 `defaults` 也指到镜像
#
# uv / uvx：索引默认跟随 PIP_INDEX_URL，不用单独配。
# 但 uv 装 Python 解释器默认去 GitHub（python-build-standalone）——内网连不上，二选一：
#   UV_PYTHON_DOWNLOADS=never                          # 只用镜像自带的 conda python 3.14
#   UV_PYTHON_INSTALL_MIRROR=https://nexus.internal/python-build-standalone   # 或指到内网镜像
# UV_SYSTEM_CERTS=1                                   # 内网 CA 已进系统证书库时（否则用 PIP_CERT / SSL_CERT_FILE）
# UV_NATIVE_TLS=1                                     # 同上，uv 旧名
# UV_INSECURE_HOST=nexus.internal                     # 自签且不想配 CA 时（跳过校验，谨慎）

# 容器内新建文件的 umask：默认 0000（666/777，宿主机可直接改会话产出与数据根）；
# 要收紧（只有容器用户可写）就设 0027。/workspace 根目录本身固定 777。
# OMP_UMASK=0027

# ── 会话工具面收敛（DESIGN §41.7）───────────────────────────────────────────
# JSON 对象（键 = omp 设置 id）→ 网关在建会话时写入 <workspace>/.omp/settings.json
# （omp project 层设置，每个新会话生效）。留空 = 不写，走 omp 默认。
#
# 内网无 GUI 部署建议关闭联网/浏览器类工具：
#   OMP_SESSION_SETTINGS_JSON={"fetch.enabled":false,"web_search.enabled":false,"browser.enabled":false,"computer.enabled":false}
#
# 常用键（以 pi-coding-agent 设置注册表为准）：
#   fetch.enabled        read 工具抓取 URL（联网）       默认 true
#   web_search.enabled   web_search 联网搜索工具         默认 true
#   browser.enabled      browser 工具（需要浏览器内核）  默认 true（检测不到内核时不出现）
#   computer.enabled     computer 工具（需要 GUI/桌面）  默认 false（检测驱动）
# 其余任意 omp 设置键同样可用（如 github.enabled / security.enabled，默认已关）。
# 注意：只影响「新建的会话」；已有会话的 workspace 不回溯改写。

# ── git 本地面（DESIGN §41.8；会话内本地版本管理，无远端要求）───────────────
# omp 的 checkpoint/rewind 是会话树机制，不依赖 git；git 用于会话内的本地保存点/历史。
# entrypoint 启动时写 $HOME/.gitconfig（每次容器启动覆盖，部署侧配置为准）：
#   GIT_USER_NAME        默认身份，缺省 omp-session（无身份时本地保存点会报
#                        "Please tell me who you are"）
#   GIT_USER_EMAIL       缺省 omp-session@localhost
#   GIT_SAFE_DIRECTORY   默认 1 = safe.directory 通配放行——/workspace 是 777 bind mount，
#                        宿主 uid ≠ 容器 1000 时 git 会以 dubious ownership 拒绝操作；
#                        =0 关闭放行（恢复属主校验）
# 注意：git 远端（git+ssh）不在默认范围——omp 生成物保存在挂载卷里，纯本地使用；
# 需要远端的会话在会话内自行配置 remote/密钥（openssh-client 已在镜像内）。
# GIT_USER_NAME=omp
# GIT_USER_EMAIL=omp@example.internal


# ── 知识库（KB）模块（DESIGN §38，可选）──────────────────────────────────────
# 网关进程自身零 minio/PDF 依赖：这些变量由容器 env 直接透传给全局 skill 目录里的
# kb_shot.py / kb_asset.py（截图/取图脚本）读取。
# 未配置 MinIO（KB_MINIO_ENDPOINT 缺省）时两个脚本回退本地模式：
# 输出落 skill 目录 assets/，agent 直接引用本地路径。
#
# 内网部署示例：
#   KB_MINIO_ENDPOINT=minio.internal:9000           # 写入端点（容器网内可达）
#   KB_MINIO_ENDPOINT_PUBLIC=https://assets.example.com   # 输出 URL 基址（外网可达）
#
# MinIO 写入端点（host:port，可带 http(s):// 前缀）。缺省 = 本地模式（落 assets/）。
# KB_MINIO_ENDPOINT=minio.internal:9000
# 输出 URL 拼接端点（外网可达）。缺省 = KB_MINIO_ENDPOINT（此时输出 URL 是内网地址，
# 报告里贴出去外网打不开——部署要交付 URL 必须配这个）；若以 http:// 或 https:// 开头
# 则直接以其为 URL 基。
# KB_MINIO_ENDPOINT_PUBLIC=https://assets.example.com
# MinIO 凭证（脚本自动建桶 + 公共读 policy，只放开下载）。
# KB_MINIO_ACCESS_KEY=minioadmin
# KB_MINIO_SECRET_KEY=minioadmin
# 桶名（默认 kb-assets）。
# KB_MINIO_BUCKET=kb-assets
# "1" = 用 https 连接 MinIO（默认 http；输出 URL 的 scheme 跟随端点里写的协议）。
# KB_MINIO_SECURE=0
# upload/pdf 路由 body 上限（MB，默认 2048；不借用 /api 的 20MB 全局面限制）。
# KB_UPLOAD_MAX_MB=2048
# =1 时 entrypoint 启动期 pip 安装 pymupdf + minio（kb_shot/kb_asset 的运行期依赖；
# pip 源走上面 §36 的 PIP_INDEX_URL，内网可用）。当前镜像已在构建期把这两个包烘进
# conda base（不设也开箱即用，entrypoint 会命中「已就绪」分支）——本开关只作旧镜像/
# 精简构建的运行时兜底。不设且镜像未烘时：kb_asset 纯标准库照常可用，kb_shot 输出缺依赖错误。
# KB_SKILL_PY_DEPS=1

# ── 全局资源层挂载（DESIGN §38.2 / §39）─────────────────────────────────────
# 工作区根目录（会话产出、网关状态、全局资源全在这棵树里；缺省 ./workspace）：
# WORKSPACE_ROOT=/srv/omp-workspace       # → 容器 /workspace（宿主机可直接读写）
# 网关私有状态与全局资源层分别挂载，便于单独备份/迁移/共享（NFS）。
# 网关数据根（gateway.db 等；必须是挂载点——否则 Docker 自动创建的父层不可写）：
# GATEWAY_DATA_ROOT_HOST=./gateway-data   # → 容器 /workspace/.omp-gateway
# 全局资源层（须是挂载点，理由同上）——**所有会话可见的全局资源都在这一层**：
# GLOBAL_ROOT=./global                    # → 容器 /workspace/.omp-gateway/global
#   global/skills/kb-<slug>/      知识库 skill（语料 + SKILL.md + scripts/references）
#   global/skills/data-query/     数据查询 skill（WrenAI 工作流）
#   global/kb/<slug>.db           知识库元数据库（+WAL）
#   global/kb/qmd/{config,cache}  qmd 索引与配置
#   global/wren/<name>/           Wren 项目 + MDL（数据查询语义层）
#   global/mcp.json               全局 MCP 注册（qmd / wren-<name>）
#   global/agents/、extensions/   全局 agent 定义与扩展
# 备份 = 打包整个 ./global（知识库部分 = skills/kb-* + kb/；db 有 -wal/-shm，
# 热备建议先停容器）。
# 权限：Docker 自动创建的空挂载源目录属主是宿主 root(755)，entrypoint 会逐层 chmod 0777
# 兜底并在不可写时告警；也可在宿主机预创建这几个目录并 chmod 777。

# ── qmd 检索引擎（KB 模块可选增强）──────────────────────────────────────────
# qmd 是语料的混合检索面（BM25 + 语义向量）：网关在入库/删文档后调 qmd update/embed
# 重建索引；会话经全局 MCP（qmd_query/qmd_get 等工具）或 CLI 检索。qmd 不可用时
# 管理面照常（SKILL.md 模板内置 grep × qmd 组合检索策略，qmd 缺失时纯 grep 路照常），只是没有增强检索。
#
# qmd 可执行文件（裸名走 PATH 查找，也可给绝对路径）。缺省 "qmd"（容器镜像内已
# bun 全局安装并打过 provider patch）。找不到时网关侧全部 no-op。
# KB_QMD_BIN=qmd
# qmd 命名索引（网关把每个 KB 语料注册为该索引下的 kb-<slug> collection）。
# KB_QMD_INDEX=kb
# =1 时：entrypoint 启动 qmd MCP HTTP daemon（同容器环回 127.0.0.1:8181/mcp），
# 网关启动把该地址写进 <dataRoot>/global/mcp.json → 新会话获得 qmd 检索工具。
# 环回地址是同容器内部服务发现（daemon 与网关同容器、部署方 env 门控），非用户可控 URL。
# KB_QMD_MCP=1
# 远端 embedding 三件套（OpenAI 兼容模式，如火山方舟 doubao embedding）：
#   KB_QMD_EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   KB_QMD_EMBED_API_KEY=<key>
#   KB_QMD_EMBED_MODEL=doubao-embedding-text-240715
# 三件齐才跑 qmd embed（语义检索生效）；任一缺失 = 只 update（BM25 即刻可用），
# 且不会退回本地 GGUF 模型下载（首次跑会拉几百 MB 模型，容器环境通常不想要）。
# embed 每批文档数（默认 16）。
# KB_QMD_EMBED_BATCH=16
# qmd 配置与缓存目录（容器内固定落挂载卷，随 dataRoot 整体迁移：collection 清单、
# 索引/模型缓存、daemon PID 文件）。注意 XDG_CACHE_HOME 是容器级 env——qmd 之外
# 遵循 XDG 的工具（uv 等）缓存位置也随之改变，有意为之（状态全部随卷走）。
# QMD_CONFIG_DIR=/workspace/.omp-gateway/global/kb/qmd/config
# XDG_CACHE_HOME=/workspace/.omp-gateway/global/kb/qmd/cache

# ── WrenAI 语义层（可选增强：自然语言查 ClickHouse/PostgreSQL）─────────────────
# wrenai（PyPI）是 agent-native Text2SQL 语义层：网关启动时按下面的数据源**种子**，
# 为每个数据源自建 Wren 项目（MDL 语义模型，落 global/wren/<名>/，宿主 ./global/wren/<名>/ 可见）
# + 起 per-数据源 `wren serve mcp` HTTP daemon（127.0.0.1 环回）+ 注册 global/mcp.json
# + 物化全局 skill data-query（简体中文工作流指南 + references/）。之后所有 omp 会话
# 都能经 wren-<名> MCP 工具（run_sql/dry_run/dry_plan/describe_schema 等，全部只读）
# 查数；网关还会自动内省 PG/CH catalog 生成每表一个 MDL model（业务描述/指标由会话
# agent 按 skill enrich）。
#
# 运行时管理（v2）：数据源的唯一事实源是注册表 <dataRoot>/global/wren/datasources.json
# （chmod 600）。下面的 env 只是**种子**——启动时仅补注册表缺失的名字，已存在的
# admin 条目优先。增删改查 / rebuild / 连接测试走 admin API（DESIGN §39.2.1）：
#   GET    /admin/wren/datasources            列表（connection 脱敏）
#   GET    /admin/wren/datasources/{name}     详情
#   PUT    /admin/wren/datasources/{name}     创建/更新 {datasource, connection, tables?}
#   DELETE /admin/wren/datasources/{name}     删除（杀 daemon + 清项目目录 + 移除注册）
#   POST   /admin/wren/datasources/{name}/rebuild  重内省 + 重生成 + daemon 重启
#   POST   /admin/wren/datasources/{name}/test     连接测试（不落注册表）
# 需 X-Admin-Id；daemon 端口创建时从 WREN_MCP_PORT_BASE 起自动分配并稳定复用。
#
# 总开关：=1 才启用；wren 不在 PATH（异常镜像）时只告警 + 物化 skill 骨架，不阻塞启动。
# WREN_MCP=1
# wren 配置根（profiles.yml / daemon 日志落点）。容器 compose 固定为挂载卷内路径，
# 且是容器级 env——会话 shell 继承后，会话内 `wren --sql` 与 daemon 用同一份 profiles。
# 本机开发不设则默认 <GATEWAY_DATA_ROOT>/wren。
# WREN_HOME=/workspace/.omp-gateway/wren
# ── 种子数据源（可省略：全部数据源都可改用 admin API 运行时注册）──────────────
# 数据源名清单：逗号分隔，每个名字须满足 ^[a-z][a-z0-9-]{0,15}$（如 pg,ch）。
# WREN_DATASOURCES=pg,ch
# 连接总 JSON（一个变量装全部数据源；compose 不支持动态变量名拼接，故不做
# WREN_DS_<名>_CONNECTION 逐个变量）。键 = WREN_DATASOURCES 里的名字；值必须含
# "datasource" 字段（wren 类型），其余连接字段以 `wren docs connection-info <类型>`
# 为准（port 是字符串）。示例（密码请替换为真实值，勿提交进仓库）：
# WREN_DS_CONNECTIONS={"pg":{"datasource":"postgres","host":"10.0.0.5","port":"5432","database":"shop","user":"ro_reader","password":"***"},"ch":{"datasource":"clickhouse","host":"10.0.0.6","port":"8123","database":"default","user":"default","password":"***","secure":false}}
# 只读语义由部署侧保证：请给网关只读账号（推荐）；示例连接也应以只读用户连接。
# 密码不落盘：网关把连接里的敏感字段（password/token 等）替换成 ${WREN_SECRET_<名>_<字段>}
# 占位符写入 profiles.yml，明文只经进程 env 传递（gateway 注入本进程 env，daemon 与
# 会话 shell 继承；wren 连接期自动展开）；注册表 datasources.json 收 600 权限。
# MCP daemon 端口分配基址（默认 8081；创建时向上找第一个空闲端口，注册表稳定复用）。
# WREN_MCP_PORT_BASE=8081
# wren 可执行文件覆盖（默认 PATH 查找 wren；容器镜像内已烘 wrenai，一般无需设置）。
# WREN_BIN=wren
# 无人值守 schema 同步（v3/M34，DESIGN §39.2.2）：每 WREN_AUTO_SYNC_MIN 分钟内省一次
# 数据源目录，与注册表 catalogHash 比对；有 drift 才增量重生成 model（按表指纹——保留
# agent enrich 的 description，手建 model 永不删）→ context build → 重启对应 daemon。
# 0 = 关闭；默认 1440（24h）；网关启动时也会做一次 drift 检查（无变化零成本）。
# 手动触发：POST /admin/wren/datasources/{名}/sync（body {"force":true} 跳过 drift 短路）。
# WREN_AUTO_SYNC_MIN=1440
#
# 信任模型：MCP HTTP daemon 只绑 127.0.0.1（同容器环回、无鉴权）——与 qmd MCP 一致，
# 部署内可信服务发现，不经过用户可控 URL；不要把 daemon 端口发布到容器外。
# 项目与状态落盘：<dataRoot>/global/wren/<名>/（MDL 项目，宿主 ./global/wren/<名>/）与
# WREN_HOME（profiles/日志）——均在挂载卷内，随卷迁移；daemon 独立于网关进程，
# 网关重启复用存量 daemon（端口在听即不重启；PUT/rebuild 会定点重启让新 MDL 生效）。
