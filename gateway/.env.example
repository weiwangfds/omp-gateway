# 网关监听端口
GATEWAY_PORT=8787

# 服务间 token（上游 Python 后端持有）。逗号分隔支持双 token 轮换窗口。
GATEWAY_SERVICE_TOKENS=change-me-service-token

# 全局层管理（/admin/global/*）无独立 token：上游注入 X-Admin-Id 标识即可（权限判定在上游）。

# 数据根目录（默认 ../../data，即 monorepo 的 data/）
# GATEWAY_DATA_ROOT=/absolute/path/to/data

# 会话空闲回收 TTL（毫秒，默认 30 分钟）
# GATEWAY_SESSION_IDLE_TTL_MS=1800000

# 每用户默认限额（懒 provision 时生效；可用 PATCH /internal/users/:uid/limits 覆盖）
# maxConcurrent = 每用户可同时跑的会话/流式数（当前产品要求：10）
# GATEWAY_DEFAULT_MAX_SESSIONS=50
# GATEWAY_DEFAULT_MAX_CONCURRENT=10
# GATEWAY_MAX_GLOBAL_STREAMING=50

# 流式并发闸门（M2）：排队超时返回 429；槽位最大持有为防泄漏 backstop
# GATEWAY_STREAM_QUEUE_TIMEOUT_MS=60000
# GATEWAY_STREAM_MAX_HOLD_MS=600000

# sqlite 定时备份（M10）：设置目录即启用；VACUUM INTO 一致性快照，保留最近 8 份
# GATEWAY_BACKUP_DIR=/absolute/path/to/backups
# GATEWAY_BACKUP_INTERVAL_MIN=60

# 环境迁移 bundle（DESIGN §32）：export 写入目录；import 允许读取的根（逗号分隔）
# 跨机迁移时两台网关指向同一共享目录（NFS/挂载卷），或把 bundle 拷入对方 import 目录
# GATEWAY_EXPORT_DIR=/absolute/path/to/gateway-exports
# GATEWAY_IMPORT_DIRS=/absolute/path/to/gateway-exports,/mnt/shared/bundles

# OpenTelemetry（M10）：1 开启 SDK spans（未注册 OTEL SDK 时为 no-op）
# GATEWAY_OTEL=0

# webhook 目标 host 白名单（M10，SSRF 收紧）：逗号分隔 host，空=不限制（内网默认）
# GATEWAY_WEBHOOK_HOSTS_ALLOWLIST=hooks.internal.example.com,10.0.0.5:9000

# 浏览器直连 CORS（DESIGN §21）：逗号分隔 origin，空=关闭（默认 BFF 代理架构无需开启）
# GATEWAY_CORS_ORIGINS=http://localhost:5173,https://app.example.com

# ── 容器内包管理器镜像源（DESIGN §36，内网部署必配）──────────────────────────
# Docker 启动时由 entrypoint 固化成 pip.conf / .npmrc / uv.toml / .condarc，
# 只影响会话里现装的包（agent 的 pip/npm、MCP server 的 npx/uvx/conda），不影响镜像自带依赖。
# 不设置 = 一行都不写，走上游默认源（公网）。
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn          # http 源或自签证书时才需要
# PIP_CERT=/etc/omp/ca.pem                            # 内网自签 CA（挂载进容器后指向它）
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# CONDA_CHANNELS=https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/main,https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/r
# CONDA_DEFAULT_CHANNELS=                              # 让 channels 里的 `defaults` 也指到镜像
#
# uv / uvx：索引默认跟随 PIP_INDEX_URL，不用单独配。
# 但 uv 装 Python 解释器默认去 GitHub（python-build-standalone）——内网连不上，二选一：
#   UV_PYTHON_DOWNLOADS=never                          # 只用镜像自带的 conda python 3.14
#   UV_PYTHON_INSTALL_MIRROR=https://nexus.internal/python-build-standalone   # 或指到内网镜像
# UV_SYSTEM_CERTS=1                                   # 内网 CA 已进系统证书库时（否则用 PIP_CERT / SSL_CERT_FILE）
# UV_NATIVE_TLS=1                                     # 同上，uv 旧名
# UV_INSECURE_HOST=nexus.internal                     # 自签且不想配 CA 时（跳过校验，谨慎）

# 容器内新建文件的 umask：默认 0000（666/777，宿主机可直接改会话产出与数据根）；
# 要收紧（只有容器用户可写）就设 0027。/workspace 根目录本身固定 777。
# OMP_UMASK=0027
