backups/

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db
coverage/
.idea/
.vscode/

# 工具产物（不入库）
.mimosa/
.zcode/

# 运行期挂载卷（compose 默认落在仓库根，属部署数据不入库）
/workspace/
/gateway-data/
/global/
